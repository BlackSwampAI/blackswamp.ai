---
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a href={`/services/${service.slug}/`} class="card service-card">
  <div class="service-icon" aria-hidden="true">{service.icon}</div>
  <h3>{service.name}</h3>
  <p class="muted">{service.summary}</p>
  <span class="learn-more">Learn more →</span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
  }

  .service-card:hover {
    text-decoration: none;
    border-color: var(--accent-dark);
  }

  .service-icon {
    font-size: 1.9rem;
    margin-bottom: 0.25rem;
  }

  .service-card h3 {
    font-size: 1.2rem;
    margin: 0;
  }

  .service-card p {
    margin: 0;
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .learn-more {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
</style>
