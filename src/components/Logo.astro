---
interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
---

<img
  src="/logo.png"
  alt=""
  class={`logo logo-${size}`}
  width="1120"
  height="320"
/>

<style>
  .logo {
    display: block;
    width: auto;
    color: transparent;
  }

  .logo-sm {
    height: 56px;
  }

  .logo-lg {
    height: 72px;
  }
</style>
