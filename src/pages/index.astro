---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/services';
import { site } from '../data/site';
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">AI &amp; Automation Consulting · {site.location.label}</p>
        <h1 class="hero-title">
          <span class="hero-brand">{site.brandTop}</span>
          <span class="hero-sub">{site.brandSub}</span>
        </h1>
        <p class="hero-lede">
          We help organizations turn useful AI ideas into dependable systems:
          workflow automation that saves time, clear technical guidance, and
          private deployments built around your data requirements.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary">Start a Conversation</a>
          <a href="/services/" class="btn btn-ghost">Explore Services</a>
          <a
            href={`mailto:${site.email}`}
            class="hero-email"
            aria-label={`Email us at ${site.email}`}
            title={site.email}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-10 6L2 7"></path>
            </svg>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/mark.png"
          alt=""
          class="hero-mark"
          width="560"
          height="560"
        />
        <ul class="hero-proof">
          <li><strong>n8n</strong> workflow automation</li>
          <li><strong>Private</strong> &amp; on-premises AI</li>
          <li><strong>Practical</strong> technology guidance</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">What we do</span>
      <h2 class="section-title">Services built for real businesses</h2>
      <p class="section-lede">
        From automating a single workflow to deploying private AI across your
        organization — we meet you where you are.
      </p>
      <div class="grid grid-2 services-grid">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section why">
    <div class="container grid why-grid">
      <div>
        <span class="eyebrow">Why BlackSwamp</span>
        <h2 class="section-title">Deep roots. Clear water.</h2>
        <p class="muted">
          Named for the Great Black Swamp that once covered northwest Ohio, we
          bring the same grit and resourcefulness this region was built on —
          now applied to the technology reshaping how work gets done.
        </p>
        <ul class="check-list">
          <li>Practical roadmaps, not pie-in-the-sky decks</li>
          <li>Open, self-hostable tooling designed for portability</li>
          <li>Privacy-conscious architecture for sensitive workloads</li>
          <li>Local partner in Toledo, working with clients everywhere</li>
        </ul>
      </div>
      <div class="stats">
        <div class="card stat">
          <strong>Hours back, weekly</strong>
          <span class="muted">Automation that runs 24/7 so your team doesn't have to.</span>
        </div>
        <div class="card stat">
          <strong>Keep control of your data</strong>
          <span class="muted">Private infrastructure options for sensitive workloads.</span>
        </div>
        <div class="card stat">
          <strong>Avoid unnecessary lock-in</strong>
          <span class="muted">Open standards and portable architecture where practical.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band card">
        <div>
          <h2>Not sure where AI fits?</h2>
          <p class="muted">
            Tell us about your workflows. We'll show you — honestly — where
            automation and AI will pay off, and where they won't.
          </p>
        </div>
        <a href="/contact/" class="btn btn-primary">Start the Conversation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 6rem 0 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    margin: 0 0 1.25rem;
  }

  .hero-brand {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: 0.02em;
    line-height: 1;
    background: linear-gradient(120deg, var(--text) 55%, var(--accent) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    font-size: clamp(0.95rem, 2vw, 1.35rem);
    font-weight: 700;
    letter-spacing: 0.55em;
    color: var(--accent);
    margin-top: 0.5rem;
  }

  .hero-lede {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--text-dim);
    max-width: 54ch;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .hero-email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.02);
    margin-left: 0.15rem;
    transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .hero-email:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .hero-email svg {
    width: 20px;
    height: 20px;
  }

  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-mark {
    width: min(400px, 88%);
    height: auto;
    filter: drop-shadow(0 0 70px rgba(34, 197, 94, 0.28));
    color: transparent;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: -2.75rem 0 0;
    position: relative;
  }

  .hero-proof li {
    background: rgba(19, 28, 22, 0.85);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    backdrop-filter: blur(8px);
  }

  .hero-proof strong {
    color: var(--accent);
    font-weight: 700;
  }

  .services-grid {
    margin-top: 2rem;
  }

  .why {
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .why-grid {
    grid-template-columns: 1.1fr 0.9fr;
    align-items: start;
    gap: 3rem;
  }

  .stats {
    display: grid;
    gap: 1rem;
  }

  .stat strong {
    display: block;
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
    color: var(--accent);
  }

  .stat span {
    font-size: 0.92rem;
  }

  .cta-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    background:
      radial-gradient(600px 200px at 90% 0%, rgba(34, 197, 94, 0.12), transparent 60%),
      var(--bg-card);
  }

  .cta-band h2 {
    margin-bottom: 0.35rem;
  }

  .cta-band p {
    margin: 0;
    max-width: 52ch;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .why-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4rem 0 3rem;
    }

    .hero-proof {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
  }
</style>
