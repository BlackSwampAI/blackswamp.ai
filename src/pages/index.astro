---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/services';
import {
  commonUseCases,
  faqs,
  industries,
  processSteps,
  startingOffers,
} from '../data/content';
import { insights } from '../data/insights';
import { site } from '../data/site';
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Based in {site.location.label} · Serving Northwest Ohio &amp; beyond</p>
        <h1>Practical AI and automation for businesses that value privacy.</h1>
        <p class="hero-lede">
          Automate repetitive work. Keep sensitive data private. Get straight
          answers about where AI fits—and where it does not.
        </p>
        <p class="hero-detail">
          BlackSwamp designs n8n workflows, private AI systems, and custom
          integrations for small and midsize businesses.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary">Tell Us What's Slowing You Down</a>
          <a href="/services/" class="btn btn-ghost">Explore Services</a>
        </div>
      </div>
      <div class="hero-visual">
        <img src="/mark.png" alt="" class="hero-mark" width="560" height="560" />
        <ul class="hero-proof" aria-label="Core capabilities">
          <li><strong>Automate</strong> the work</li>
          <li><strong>Protect</strong> the data</li>
          <li><strong>Choose</strong> the right AI</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <span class="eyebrow">Three ways we help</span>
      <h2 id="services-heading" class="section-title">Start with the business problem</h2>
      <p class="section-lede">
        The right solution may be a workflow, a private model, a focused
        integration, or no AI at all. We help you make that call and build what
        earns its place.
      </p>
      <div class="grid grid-3 services-grid">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section surface" aria-labelledby="use-cases-heading">
    <div class="container split-grid">
      <div>
        <span class="eyebrow">Problems we solve</span>
        <h2 id="use-cases-heading" class="section-title">Useful work, not novelty demos</h2>
        <p class="section-lede">
          We focus on processes where better information flow, careful AI
          assistance, or private access to knowledge can produce a measurable
          operational improvement.
        </p>
      </div>
      <ul class="use-case-list">
        {commonUseCases.map((useCase) => <li>{useCase}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="industries-heading">
    <div class="container">
      <span class="eyebrow">Who we help</span>
      <h2 id="industries-heading" class="section-title">Built for practical operators</h2>
      <p class="section-lede">
        Especially useful for organizations with lean teams, fragmented tools,
        document-heavy work, or data that deserves more care.
      </p>
      <div class="grid grid-3 industry-grid">
        {
          industries.map((industry) => (
            <article class="industry card">
              <h3>{industry.name}</h3>
              <p class="muted">{industry.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section surface" aria-labelledby="offers-heading">
    <div class="container">
      <span class="eyebrow">Low-risk starting points</span>
      <h2 id="offers-heading" class="section-title">You do not need a giant AI initiative</h2>
      <p class="section-lede">
        Begin with enough structure to make a good decision, then expand only
        when the evidence supports it.
      </p>
      <div class="grid grid-3 offers-grid">
        {
          startingOffers.map((offer) => (
            <article class="offer card">
              <span class="offer-label">{offer.label}</span>
              <h3>{offer.name}</h3>
              <p class="muted">{offer.description}</p>
              <p class="deliverable"><strong>You leave with:</strong> {offer.deliverable}</p>
              <a href={offer.href} class="text-link">Ask about this offer →</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <span class="eyebrow">How we work</span>
      <h2 id="process-heading" class="section-title">Discover → Prioritize → Pilot → Operate</h2>
      <div class="process-grid">
        {
          processSteps.map((step) => (
            <article class="process-step">
              <span>{step.number}</span>
              <h3>{step.name}</h3>
              <p class="muted">{step.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section surface" aria-labelledby="why-heading">
    <div class="container split-grid why-grid">
      <div>
        <span class="eyebrow">Why BlackSwamp</span>
        <h2 id="why-heading" class="section-title">Local roots. Technical depth. Clear advice.</h2>
        <p class="muted">
          Named for the Great Black Swamp that shaped Northwest Ohio, we bring
          the region's practical resourcefulness to technology that can be
          difficult to evaluate and easy to oversell.
        </p>
      </div>
      <div class="principles">
        <div><strong>Problem first</strong><span>AI is a tool, not the starting requirement.</span></div>
        <div><strong>Privacy by design</strong><span>Data boundaries shape the architecture from day one.</span></div>
        <div><strong>Human control</strong><span>Important decisions keep appropriate review and accountability.</span></div>
        <div><strong>Portable choices</strong><span>Open, self-hostable tools are preferred where they make sense.</span></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="insights-heading">
    <div class="container">
      <span class="eyebrow">Field notes</span>
      <h2 id="insights-heading" class="section-title">Useful guidance before you buy anything</h2>
      <div class="grid grid-3 insights-grid">
        {
          insights.slice(0, 3).map((article) => (
            <a href={`/insights/${article.slug}/`} class="insight card">
              <span>{article.category}</span>
              <h3>{article.title}</h3>
              <p class="muted">{article.description}</p>
              <strong>Read the guide →</strong>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section surface" aria-labelledby="faq-heading">
    <div class="container faq-wrap">
      <div>
        <span class="eyebrow">Common questions</span>
        <h2 id="faq-heading" class="section-title">A few straight answers</h2>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p class="muted">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band card">
        <div>
          <span class="eyebrow">Start with the bottleneck</span>
          <h2>What keeps wasting your team's time?</h2>
          <p class="muted">
            Send the rough version. We will help turn it into a practical next step.
          </p>
        </div>
        <a href="/contact/" class="btn btn-primary">Tell Us What's Slowing You Down</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 6rem 0 4.5rem;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .hero-grid,
  .split-grid,
  .faq-wrap {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    max-width: 17ch;
    margin-bottom: 1.25rem;
    background: linear-gradient(120deg, var(--text) 60%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    color: var(--text);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    max-width: 54ch;
  }

  .hero-detail {
    color: var(--text-dim);
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-mark {
    width: min(400px, 88%);
    height: auto;
    filter: drop-shadow(0 0 70px rgba(34, 197, 94, 0.28));
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: -2.75rem 0 0;
    position: relative;
  }

  .hero-proof li {
    background: rgba(19, 28, 22, 0.9);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    color: var(--text-dim);
    font-size: 0.85rem;
  }

  .hero-proof strong,
  .text-link,
  .insight strong {
    color: var(--accent);
  }

  .surface {
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .services-grid,
  .industry-grid,
  .offers-grid,
  .insights-grid {
    margin-top: 2rem;
  }

  .use-case-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .use-case-list li {
    color: var(--text-dim);
    padding: 1rem 1.1rem 1rem 2.7rem;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .use-case-list li:nth-child(odd) { border-right: 1px solid var(--border); }
  .use-case-list li:nth-last-child(-n + 2) { border-bottom: 0; }
  .use-case-list li::before {
    content: '↗';
    position: absolute;
    left: 1rem;
    color: var(--accent);
    font-weight: 700;
  }

  .industry p,
  .offer p,
  .insight p {
    margin-bottom: 0;
  }

  .industry h3,
  .offer h3,
  .insight h3 {
    font-size: 1.1rem;
  }

  .offer {
    display: flex;
    flex-direction: column;
  }

  .offer-label,
  .insight > span {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.65rem;
  }

  .deliverable {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .offer .text-link {
    margin-top: auto;
    padding-top: 1rem;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 2rem;
    border-top: 1px solid var(--border-strong);
  }

  .process-step {
    padding: 1.5rem 1.5rem 0 0;
    border-right: 1px solid var(--border);
    min-height: 180px;
  }

  .process-step + .process-step { padding-left: 1.5rem; }
  .process-step:last-child { border-right: 0; }
  .process-step > span { color: var(--accent); font-weight: 800; font-size: 0.8rem; }
  .process-step h3 { margin-top: 1.25rem; }
  .process-step p { font-size: 0.92rem; margin: 0; }

  .why-grid { align-items: start; }
  .principles { display: grid; gap: 0; border-top: 1px solid var(--border); }
  .principles > div { display: grid; grid-template-columns: 0.65fr 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .principles strong { color: var(--accent); }
  .principles span { color: var(--text-dim); }

  .insight {
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .insight:hover { text-decoration: none; border-color: var(--accent-dark); }
  .insight strong { margin-top: auto; padding-top: 1rem; font-size: 0.9rem; }

  .faq-wrap { align-items: start; }
  .faq-list { border-top: 1px solid var(--border-strong); }
  details { border-bottom: 1px solid var(--border); }
  summary { cursor: pointer; padding: 1.1rem 2rem 1.1rem 0; font-weight: 700; position: relative; }
  summary::marker { color: var(--accent); }
  details p { padding: 0 0 1.1rem; margin: 0; }

  .cta-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    background: radial-gradient(600px 200px at 90% 0%, rgba(34, 197, 94, 0.12), transparent 60%), var(--bg-card);
  }

  .cta-band h2 { margin-bottom: 0.35rem; }
  .cta-band p { margin: 0; max-width: 52ch; }

  @media (max-width: 900px) {
    .hero-grid,
    .split-grid,
    .faq-wrap { grid-template-columns: 1fr; gap: 2.5rem; }
    .process-grid { grid-template-columns: 1fr 1fr; }
    .process-step:nth-child(2) { border-right: 0; }
  }

  @media (max-width: 640px) {
    .hero { padding: 4rem 0 3rem; }
    .hero h1 { font-size: clamp(2.35rem, 12vw, 3.4rem); }
    .hero-proof { flex-direction: column; text-align: center; align-items: stretch; }
    .use-case-list,
    .process-grid { grid-template-columns: 1fr; }
    .use-case-list li,
    .use-case-list li:nth-child(odd),
    .use-case-list li:nth-last-child(-n + 2) { border-right: 0; border-bottom: 1px solid var(--border); }
    .use-case-list li:last-child { border-bottom: 0; }
    .process-step,
    .process-step + .process-step { border-right: 0; border-bottom: 1px solid var(--border); padding: 1.25rem 0; min-height: 0; }
    .principles > div { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
