---
import Base from '../../layouts/Base.astro';
import { services, type Service } from '../../data/services';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const otherServices = services.filter((s) => s.slug !== service.slug);
---

<Base title={service.name} description={service.summary}>
  <section class="section">
    <div class="container">
      <a href="/services/" class="back-link">← All services</a>
      <div class="service-hero">
        <div class="service-icon" aria-hidden="true">{service.icon}</div>
        <div>
          <h1>{service.name}</h1>
          <p class="tagline accent">{service.tagline}</p>
        </div>
      </div>
      <p class="summary">{service.summary}</p>

      <div class="service-body">
        <div class="prose">
          {
            service.details.map((paragraph) => (
              <p class="muted">{paragraph}</p>
            ))
          }
          <div class="cta-inline card">
            <h3>Ready to get started?</h3>
            <p class="muted">
              Let's talk about your goals and map out a plan — no obligation,
              no hype.
            </p>
            <a href="/contact/" class="btn btn-primary">Start a Conversation</a>
          </div>
        </div>
        <aside class="service-side">
          <div class="card">
            <h3>What's included</h3>
            <ul class="check-list">
              {service.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-tight more">
    <div class="container">
      <h2 class="section-title">More services</h2>
      <div class="more-grid">
        {
          otherServices.map((s) => (
            <a href={`/services/${s.slug}/`} class="card more-card">
              <span aria-hidden="true">{s.icon}</span>
              <span>{s.name} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .back-link {
    display: inline-block;
    color: var(--text-faint);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .service-hero {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  .service-icon {
    font-size: 3rem;
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    margin: 0;
  }

  .tagline {
    margin: 0.35rem 0 0;
    font-weight: 600;
  }

  .summary {
    font-size: 1.15rem;
    max-width: 70ch;
    margin-bottom: 2.5rem;
  }

  .service-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .prose p {
    margin-bottom: 1.25rem;
  }

  .service-side {
    position: sticky;
    top: 90px;
  }

  .service-side h3 {
    font-size: 1.05rem;
  }

  .cta-inline {
    margin-top: 2rem;
    background:
      radial-gradient(400px 160px at 100% 0%, rgba(34, 197, 94, 0.12), transparent 60%),
      var(--bg-card);
  }

  .cta-inline h3 {
    margin-bottom: 0.35rem;
  }

  .more {
    border-top: 1px solid var(--border);
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .more-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem;
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .more-card:hover {
    text-decoration: none;
    border-color: var(--accent-dark);
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .service-body {
      grid-template-columns: 1fr;
    }

    .service-side {
      position: static;
      order: -1;
    }

    .more-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
