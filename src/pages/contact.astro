---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Contact"
  description={`Contact BlackSwamp AI Solutions in ${site.location.label} about workflow automation, AI consulting, private deployments, and custom software.`}
>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">Contact</span>
        <h1 class="section-title">Let's talk about your business</h1>
        <p class="section-lede">
          Tell us what is slowing you down, what you have already tried, and
          what a useful outcome would look like. We will start with the problem
          and recommend AI only when it earns its place.
        </p>
        <ul class="contact-details">
          <li>
            <strong>Email</strong>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <strong>Location</strong>
            <span class="muted">{site.location.label}</span>
          </li>
        </ul>
      </div>

      <div class="contact-card card">
        <span class="eyebrow">Start here</span>
        <h2>Email us directly</h2>
        <p class="muted">
          A useful first note includes the process you want to improve, the
          tools involved, and any security or hosting requirements. Rough notes
          are perfectly fine.
        </p>
        <a
          href={`mailto:${site.email}?subject=Project%20inquiry`}
          class="btn btn-primary"
        >
          Email {site.email}
        </a>
        <p class="privacy-note">
          Please do not include passwords, API keys, or sensitive customer data.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: start;
  }

  .contact-details {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1.25rem;
  }

  .contact-details strong {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    margin-bottom: 0.2rem;
  }

  .contact-card {
    padding: 2rem;
  }

  .contact-card h2 {
    margin-bottom: 0.75rem;
  }

  .contact-card .btn {
    margin-top: 0.5rem;
  }

  .privacy-note {
    color: var(--text-faint);
    font-size: 0.8rem;
    margin: 1.25rem 0 0;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
