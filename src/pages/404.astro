---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found" description="The page you're looking for doesn't exist." noindex>
  <section class="section not-found">
    <div class="container">
      <p class="code">404</p>
      <h1>Lost in the swamp</h1>
      <p class="muted">
        The page you're looking for doesn't exist — or has been moved.
      </p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/services/" class="btn btn-ghost">View Services</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    text-align: center;
    padding: 7rem 0;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 900;
    line-height: 1;
    margin: 0;
    background: linear-gradient(120deg, var(--text) 55%, var(--accent) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0.75rem 0 0.5rem;
  }

  .actions {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
